# Copy this file to .env for local development. Never commit .env.
MINIDATADEV_ENV=development
MINIDATADEV_DATA_DIR=.minidatadev/data
MINIDATADEV_DATABASE_PATH=.minidatadev/minidatadev.sqlite3
MINIDATADEV_MAX_UPLOAD_MB=100
MINIDATADEV_RETENTION_DAYS=30
MINIDATADEV_REQUESTS_PER_HOUR=30
MINIDATADEV_LOG_PATH=.minidatadev/events.jsonl

# Optional: leave blank to use the built-in demo assistant.
OPENAI_API_KEY=
MINIDATADEV_AI_PROVIDER=demo
MINIDATADEV_AI_MODEL=gpt-5.6

# Optional evaluation cost estimates. Set these from your provider's current
# price per one million tokens; no pricing is assumed by default.
# MINIDATADEV_INPUT_PRICE_PER_MILLION=
# MINIDATADEV_OUTPUT_PRICE_PER_MILLION=
